##ROBOREG

##Take 20 images, depth data and joint states

#Add the below functions to bashrc.

nano ~/.bashrc
#Copy paste the below functions in the bashrc file and save.

##Segment

rr_sam2() {
    rr-sam2 \
        --path /home/ubuntu/Deepak_WS/Roboreg_test/franka_top \
        --pattern "franka_image_*.png" \
        --n-positive-samples 20 \
        --n-negative-samples 20 \
        --device cuda
}


##Hydra

rr_hydra() {
    rr-hydra \
        --camera-info-file /home/ubuntu/Deepak_WS/Roboreg_test/camera_info/came>
        --path /home/ubuntu/Deepak_WS/Roboreg_test/franka_top \
        --mask-pattern mask_sam2_franka_image_*.png \
        --depth-pattern franka_depth_*.npy \
        --joint-states-pattern franka_joints_*.npy \
        --ros-package franka_description \
        --xacro-path robots/fr3/fr3_src.urdf.xacro \
        --root-link-name fr3_link0 \
        --end-link-name fr3_hand \
        --number-of-points 20000 \
        --output-file HT_hydra_robust.npy
}


##Render

rr_render() {
    rr-render \
        --batch-size 1 \
        --num-workers 0 \
        --ros-package franka_description \
        --xacro-path robots/fr3/fr3_src.urdf.xacro \
        --root-link-name fr3_link0 \
        --end-link-name fr3_hand \
        --camera-info-file /home/ubuntu/Deepak_WS/Roboreg_test/camera_info/came>
        --extrinsics-file /home/ubuntu/Deepak_WS/Roboreg_test/franka/HT_hydra_r>
        --images-path /home/ubuntu/Deepak_WS/Roboreg_test/franka_top \
        --joint-states-path /home/ubuntu/Deepak_WS/Roboreg_test/franka_top \
        --image-pattern franka_image_*.png \
        --joint-states-pattern franka_joints_*.npy \
        --output-path /home/ubuntu/Deepak_WS/Roboreg_test/franka_top
}

#Source bashrc
source ~/.bashrc

#If inside any conda env, deactivate first
conda deactivate

# Python venv

source roboreg/bin/activate

#Source ROS 

source /opt/ros/humble/setup.bash
source /home/ubuntu/Debojit_ws/franka_ros2_ws/install/setup.bash

#Run the functions

#Perform segmentation by selecting positive and negative samples in the displayed images.
rr_sam2

#Gives the point cloud mapping on the robot mesh and gives the Homogenouse Transformation matrix.
rr_hydra

#Render the robot in the images i.e shows the overlay of the robot model on the images. To verify if the HT matrix is correct.
rr_render


